// Describes how the thread is started and stopped
.RmwCA=1
.RmwDA=0
.RdcDA=1
.StrideCA=1
.StrideDA=1
.StrideSA=1
.StridePA=0

// Constants which must be defined and compiled into the program
.constant:vth
.constant:scale
.constant:scale_exp
.constant:bias_exp
.constant:interval_sub_1  // should be power of 2 minus 1

// Aliases for variables
// t0ls has da at the start of the update pass
// and spike payload at the end of the pass
.var:da@t0ls        // DendAccum input
.var:payload@t0ls   // spike payload
.var:act@s0ls       // to store activation
.var:abs_delta@s3ls // to store delta
.var:time@t7bs
.var:da_@s0ls

// Structure to be used by Python to access compartment memory
.mem:CA[0] {
 ls act_ref;
 ls sigma;    
 ws bias; 
} // each CA has 64 bits

:pass0
mov da_ da
//sub time offset          // time -= offset
and time interval_sub_1  // time = time & interval_sub_1 (equivalent to time % (interval) if interval is power of 2)
cmp_eq time 0            // reset u, v if time == 0
skp_nc 2
mov sigma 0
mov act_ref 0
rmw_ca 0
next

:pass1
add sigma da_            // Accumulate delta input
mov act bias            // act = bias
shl act bias_exp        // act = bias << bias_exp
add_sat act sigma           // act += sigma
max act 0               // act = max(act_new, 0) = ReLU(sigma + bias)
mul_rn scale_exp act scale // multiply - right-shift
rmw_ca 0
next

:pass2
add act_ref act         // act_ref = act - act_old + residue = delta
abs abs_delta act_ref   // abs_delta = abs(delta)
cmp_lt abs_delta vth
skp_nc 2
// if !spike: residue = delta => act_ref = delta - act
sub act_ref act         // act_ref = delta - act
end
// if spike: residue = 0 => act_ref = 0 - act
mov payload act_ref     // payload = delta
mov act_ref act         // act_ref = act
neg act_ref act_ref     // act_ref = - act
spike 0                 // send spike to first axon of neuron
